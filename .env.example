# Copia este archivo como .env para usar Firebase en tu computadora (node server.js).
# En Vercel pon estas mismas variables en Settings -> Environment Variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Opcional: servidor TURN para redes muy cerradas donde la conexión directa falla
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
